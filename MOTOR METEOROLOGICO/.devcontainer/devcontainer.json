{
  "name": "ARGWX - motor meteorológico",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user -r argwx/requirements-dev.txt",
  "postAttachCommand": "cd argwx && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "ARGWX API", "onAutoForward": "openBrowser" }
  },
  "containerEnv": { "ARGWX_DATA_MODE": "auto" },
  "customizations": {
    "codespaces": { "openFiles": ["argwx/README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
