rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(id) { return signedIn() && request.auth.uid == id; }
    function ownerAccount() {
      return signedIn() &&
        request.auth.token.email == 'info.consultoradiagonales@gmail.com';
    }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function staff() {
      return signedIn() && profile().disabled != true &&
        profile().role in ['coordinator', 'admin', 'moderator'];
    }
    function admin() {
      return signedIn() && profile().disabled != true && profile().role == 'admin';
    }
    function coordinatorFor(municipalityId) {
      return staff() && (profile().role == 'admin' ||
        profile().municipalityId == municipalityId);
    }
    function workerFor(report) {
      return signedIn() && profile().disabled != true &&
        profile().role == 'field_worker' &&
        profile().municipalityId == report.municipalityId &&
        profile().teamId == report.assignedTeamId;
    }

    match /users/{userId} {
      allow get: if own(userId) || staff();
      allow list: if staff();
      allow create: if own(userId) &&
        ((request.resource.data.role == 'citizen' &&
          request.resource.data.disabled == false) ||
         (ownerAccount() && request.resource.data.role == 'admin' &&
          request.resource.data.disabled == false));
      allow update: if admin() || (own(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'realName', 'photoURL', 'fcmToken', 'reportsCount',
          'lastReportAt', 'updatedAt', 'municipalityId', 'municipalityName',
          'provinceId', 'province', 'departmentId', 'department',
          'localityId', 'locality', 'settlementId', 'settlement'
        ]) &&
        request.resource.data.reportsCount >= resource.data.reportsCount &&
        // El municipio lo elige el vecino al registrarse y puede cambiarlo si
        // se muda. Para el personal municipal es distinto: su municipio define
        // qué reportes ve, así que dejarlo cambiarlo sería darle acceso a los
        // datos de otro municipio.
        (request.resource.data.municipalityId == resource.data.municipalityId ||
          resource.data.role == 'citizen')) ||
        (own(userId) && ownerAccount() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'disabled', 'updatedAt'
          ]) && request.resource.data.role == 'admin' &&
          request.resource.data.disabled == false);
      allow delete: if own(userId) || admin();
    }

    match /teams/{teamId} {
      // Las fichas operativas contienen responsables y personal de cuadrilla.
      // Sólo las cuentas de gestión pueden consultarlas.
      allow read: if staff();
      allow write: if admin();
    }

    match /municipalities/{municipalityId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /municipalityStats/{municipalityId} {
      allow read: if coordinatorFor(municipalityId);
    }

    // AI results are server-authored and never writable by clients.
    match /reportInsights/{reportId} {
      allow get: if signedIn() && exists(/databases/$(database)/documents/reports/$(reportId)) &&
        (own(get(/databases/$(database)/documents/reports/$(reportId)).data.userId) ||
          coordinatorFor(get(/databases/$(database)/documents/reports/$(reportId)).data.municipalityId));
      allow list, create, update, delete: if false;
    }

    match /reports/{reportId} {
      allow read: if signedIn() &&
        (resource.data.hidden == false || own(resource.data.userId) ||
          coordinatorFor(resource.data.municipalityId) || workerFor(resource.data));
      allow create: if signedIn() && own(request.resource.data.userId) &&
        request.resource.data.municipalityId == profile().municipalityId &&
        request.resource.data.status == 'pending' &&
        request.resource.data.hidden == false &&
        (!('aiRequested' in request.resource.data) || request.resource.data.aiRequested is bool) &&
        (!('aiConsentVersion' in request.resource.data) || request.resource.data.aiConsentVersion in [0, 1]);
      allow update: if signedIn() && (
        (own(resource.data.userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rating', 'ratingComment', 'hidden', 'updatedAt'
          ]) &&
          (request.resource.data.hidden == resource.data.hidden ||
            request.resource.data.hidden == true) &&
          (request.resource.data.rating == resource.data.rating ||
            resource.data.status in ['resolved', 'closed'])) ||
        (workerFor(resource.data) && (
          (resource.data.status == 'assigned' &&
            request.resource.data.status == 'in_progress' &&
            request.resource.data.assignedWorkerId == request.auth.uid &&
            request.resource.data.photosBefore.size() > 0 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'workerArrivedAt', 'workStartedAt', 'assignedWorkerId',
              'photosBefore', 'updatedAt'
            ])) ||
          (resource.data.status == 'in_progress' &&
            request.resource.data.status == 'resolved' &&
            resource.data.assignedWorkerId == request.auth.uid &&
            request.resource.data.photosAfter.size() > 0 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'photosAfter', 'workFinishedAt', 'resolvedAt',
              'workerNotes', 'updatedAt'
            ])) ||
          (resource.data.status == 'in_progress' &&
            request.resource.data.status == 'in_progress' &&
            resource.data.assignedWorkerId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'photosProgress', 'updatedAt'
            ]))
        )) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'supportCount'
        ]) && request.resource.data.supportCount == resource.data.supportCount + 1 &&
          !exists(/databases/$(database)/documents/reports/$(reportId)/supportVotes/$(request.auth.uid)) &&
          existsAfter(/databases/$(database)/documents/reports/$(reportId)/supportVotes/$(request.auth.uid))) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'flaggedCount'
        ]) && request.resource.data.flaggedCount == resource.data.flaggedCount + 1)
      );
      // La asignación se ejecuta exclusivamente en assignReportTeam (Admin SDK).
      allow delete: if admin();

      match /supportVotes/{voteUserId} {
        allow read: if signedIn();
        allow create: if own(voteUserId) &&
          request.resource.data.userId == voteUserId;
      }

      match /comments/{commentId} {
        allow read: if signedIn() && resource.data.hidden == false;
        allow create: if signedIn() &&
          request.resource.data.userId == request.auth.uid;
        allow update: if staff();
      }
    }

    match /localAds/{adId} {
      allow read: if admin() || (signedIn() && resource.data.active == true &&
        resource.data.municipalityId == profile().municipalityId);
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['municipalityId', 'business', 'message', 'imageUrl', 'link', 'startsAt', 'endsAt', 'active', 'updatedAt']) &&
        request.resource.data.municipalityId is string &&
        request.resource.data.business is string && request.resource.data.business.size() > 0 && request.resource.data.business.size() <= 80 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 180 &&
        request.resource.data.imageUrl is string &&
        (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('https://.*')) &&
        request.resource.data.link is string && request.resource.data.link.matches('https://.*') &&
        request.resource.data.startsAt is timestamp && request.resource.data.endsAt is timestamp &&
        request.resource.data.endsAt > request.resource.data.startsAt &&
        request.resource.data.active is bool && request.resource.data.updatedAt == request.time;
      allow delete: if admin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && own(resource.data.userId);
      allow update: if signedIn() && own(resource.data.userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;
    }

    match /contentFlags/{flagId} {
      allow read, update: if staff();
      allow create: if signedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
    }
  }
}
