# env.example — Variables de entorno requeridas
# Copiar como .env (que está en .gitignore) y completar los valores reales

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=que-pasa-en-tu-barrio
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=que-pasa-en-tu-barrio.firebaseapp.com
FIREBASE_STORAGE_BUCKET=que-pasa-en-tu-barrio.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID_ANDROID=1:123456789:android:abc123
FIREBASE_APP_ID_IOS=1:123456789:ios:abc123
FIREBASE_APP_ID_WEB=1:123456789:web:abc123

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSy...
GOOGLE_MAPS_API_KEY_IOS=AIzaSy...
GOOGLE_MAPS_API_KEY_WEB=AIzaSy...

# ── Android signing ───────────────────────────────────────────────────────────
# Ver tools/signing/README.md para generar el keystore
KEYSTORE_PATH=tools/signing/release.jks
KEYSTORE_ALIAS=que-pasa-en-tu-barrio
KEYSTORE_PASSWORD=
KEY_PASSWORD=
