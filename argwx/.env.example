# Copiar a .env (make env lo hace y genera una clave aleatoria). Nunca subir .env al repositorio.
POSTGRES_PASSWORD=cambiar_esta_clave

ARGWX_ENV=development
# live = solo datos reales | demo = escenario simulado | auto = reales y, si fallan, simulado (avisado)
ARGWX_DATA_MODE=auto
ARGWX_SYNC_INTERVAL_MIN=180
# Protege POST /api/v1/observations y /api/v1/alerts/calculate (header X-ARGWX-Token). Obligatorio en producción.
ARGWX_ADMIN_TOKEN=
ARGWX_CORS_ORIGINS=*

# Open-Meteo: el plan gratuito es solo para uso no comercial. Para un cliente: contratar plan y cargar la key.
ARGWX_OPEN_METEO_API_KEY=
# Feeds del SMN (CAP o GeoRSS), separados por coma. Confirmar la URL oficial vigente.
# ARGWX_SMN_CAP_URLS=https://...

# Proveedores opcionales (se activan con su key)
ARGWX_OPENWEATHER_API_KEY=
ARGWX_METEOBLUE_API_KEY=
ARGWX_WUNDERGROUND_API_KEY=
ARGWX_WUNDERGROUND_STATIONS=
